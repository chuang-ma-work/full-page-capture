{
  "manifest_version": 3,
  "name": "Full Page Capture",
  "version": "1.0.0",
  "description": "Capture full-page screenshots of any website",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "script-src": ["'self'"]
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}
